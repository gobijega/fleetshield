# Local (docker-compose) example — no SSL:
DATABASE_URL=postgres://fleetshield:fleetshield_dev@localhost:5432/fleetshield
PGSSL=disable

# Timescale Cloud / production example (SSL required, PGSSL left unset):
# DATABASE_URL=postgres://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb

PORT=3000
DB_WRITE_EVERY_N_TICKS=1

# --- Admin login -------------------------------------------------------
# Generate the password hash with: npm run hash-password -- "your-password"
# (password must be 12+ characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional — turns on mandatory TOTP MFA for login. Generate with: npm run setup-mfa
# Leave unset for password-only login (fine for local dev).
# ADMIN_TOTP_SECRET=

# --- Billing (Stripe) ----------------------------------------------------
# All four required for self-service signup + subscription billing to work.
# Leave unset to disable signup/billing entirely (existing single-admin
# deployments keep working fine without these).
#
# Get STRIPE_SECRET_KEY from https://dashboard.stripe.com/apikeys — use a
# *restricted* key with only Customers/Checkout Sessions/Subscriptions/
# Subscription Items write access if you want to scope it down from a full
# secret key. Never commit this value or paste it into chat/logs.
# STRIPE_SECRET_KEY=sk_live_...
#
# From the webhook endpoint's settings page in the Stripe dashboard
# (Developers -> Webhooks) — verifies that webhook requests actually came
# from Stripe.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# The recurring Price ID for the $17.50 AUD/vehicle/month plan.
# STRIPE_PRICE_ID=price_...
#
# Used to build Stripe Checkout's success/cancel redirect URLs — must be
# the public URL this app is reachable at (e.g. https://fleetshield.systems).
# APP_BASE_URL=http://localhost:3000
